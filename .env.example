# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://puwcalvtklwtgaixnzxq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_aEueEjzj3itcgZ96ir4tfQ_9eJeNziy

# FastAPI configuration
API_ENV=local
API_CORS_ORIGINS=http://localhost:3000
# Server-side Supabase URL (same value as NEXT_PUBLIC_SUPABASE_URL, for backend use)
SUPABASE_URL=https://your-project.supabase.co
# Server-side Supabase key (NEVER expose a browser build) — used by apps/api only.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Client-auth secret the external sticky widget/portal must send as X-Channel-Secret.
INTAKE_CHANNEL_SECRET=replace-me
# Base URL the magic-link reply flows point back to.
REPORT_BASE_URL=http://localhost:3000
STORAGE_ACCESS_TOKEN_TTL_DAYS=7

# Future local services
REDIS_URL=redis://localhost:6379/0
STORAGE_BUCKET=ticket-attachments
